{
  "name": "moonlit-tarot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 3000 --bind 0.0.0.0",
    "test": "node --test",
    "build:android-web": "python3 scripts/build_android_web.py",
    "android:sync": "npm run build:android-web && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "test:android-web": "npm run build:android-web && node scripts/test_android_web.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=22"
  }
}
